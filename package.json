{
  "name": "openreel",
  "version": "1.0.0",
  "private": true,
  "description": "OpenReel — a legal, public-domain streaming site built on Internet Archive films.",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "next lint",
    "ingest": "node scripts/ingest.mjs",
    "ingest:refresh": "node scripts/ingest.mjs --refresh",
    "verify:streams": "node scripts/verify-streams.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "next": "15.5.4",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "tailwindcss": "^4.1.13",
    "typescript": "^5.7.0",
    "vitest": "^2.1.8"
  }
}
