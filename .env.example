# OpenReel environment — every variable here is OPTIONAL.
# The site builds and runs with zero configuration and zero API keys.

# Optional: absolute site URL used for metadata / OpenGraph tags.
NEXT_PUBLIC_SITE_URL=https://openreel.example

# Optional: number of items the ingester requests per collection per page.
INGEST_ROWS=100

# Optional: comma-separated Internet Archive collections for scripts/ingest.mjs
INGEST_COLLECTIONS=feature_films,film_noir,sci-fi_horror,classic_tv,serials,animationandcartoons,prelinger,silent_films,mysteryandcrimefilms,comedy_films
